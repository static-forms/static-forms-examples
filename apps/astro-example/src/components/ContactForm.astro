---
const apiKey = import.meta.env.PUBLIC_STATICFORMS_API_KEY || 'YOUR_API_KEY';
---

<div class="success-message" id="success-message" hidden>
	<svg class="success-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
		<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
		<polyline points="22 4 12 14.01 9 11.01"></polyline>
	</svg>
	<h2>Message Sent!</h2>
	<p>Thank you for reaching out. We'll get back to you soon.</p>
	<button type="button" class="reset-button" id="reset-button">Send another message</button>
</div>

<form class="form" id="contact-form" data-api-key={apiKey}>
	<div class="field">
		<label for="name" class="label">Name</label>
		<input type="text" id="name" name="name" class="input" placeholder="Your name" required />
	</div>

	<div class="field">
		<label for="email" class="label">Email</label>
		<input type="email" id="email" name="email" class="input" placeholder="your@email.com" required />
	</div>

	<div class="field">
		<label for="message" class="label">Message</label>
		<textarea id="message" name="message" class="textarea" placeholder="Your message..." rows="5" required
		></textarea>
	</div>

	<div class="error-message" id="error-message" hidden></div>

	<button type="submit" class="submit-button" id="submit-button">Send Message</button>
</form>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form')!;
	const submitButton = document.querySelector<HTMLButtonElement>('#submit-button')!;
	const errorBox = document.querySelector<HTMLDivElement>('#error-message')!;
	const successBox = document.querySelector<HTMLDivElement>('#success-message')!;
	const resetButton = document.querySelector<HTMLButtonElement>('#reset-button')!;

	function setLoading(loading: boolean) {
		for (const field of form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')) {
			field.disabled = loading;
		}
		submitButton.disabled = loading;
		submitButton.innerHTML = loading ? '<span class="spinner"></span>Sending...' : 'Send Message';
	}

	function showError(message: string) {
		errorBox.textContent = message;
		errorBox.hidden = false;
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		errorBox.hidden = true;

		// Read values before disabling the fields (disabled fields are excluded from FormData)
		const formData = new FormData(form);
		setLoading(true);

		const data = {
			apiKey: form.dataset.apiKey,
			name: formData.get('name'),
			email: formData.get('email'),
			message: formData.get('message'),
			replyTo: '@', // Uses sender's email as reply-to
			subject: 'New Contact Form Submission',
		};

		try {
			const response = await fetch('https://api.staticforms.dev/submit', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(data),
			});

			const result: { success: boolean; message?: string } = await response.json();

			if (result.success) {
				form.reset();
				form.hidden = true;
				successBox.hidden = false;
			} else {
				showError(result.message || 'Something went wrong');
			}
		} catch {
			showError('Failed to send message. Please try again.');
		} finally {
			setLoading(false);
		}
	});

	resetButton.addEventListener('click', () => {
		successBox.hidden = true;
		form.hidden = false;
	});
</script>
